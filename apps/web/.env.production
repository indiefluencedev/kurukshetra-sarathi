# The Worker that serves updatable content. See docs/12.
# Unset this and the app falls back to its bundled calendar — see content/live.ts.
VITE_CONTENT_URL=https://kuk-saarthi-api.indiefluence-in-media.workers.dev

# Where photographs are served from — the same Worker's /img/ route, backed by
# R2. Kept separate from VITE_CONTENT_URL on purpose: media can later move to
# its own origin (a custom domain in front of the bucket) without dragging the
# content feeds with it, and unsetting CONTENT_URL to test the bundled calendar
# must not also blank every picture in the app.
VITE_MEDIA_URL=https://kuk-saarthi-api.indiefluence-in-media.workers.dev
