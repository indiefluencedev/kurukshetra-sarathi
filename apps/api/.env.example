# Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# ONE file. Both halves of local development read it:
#
#   the Worker      `wrangler dev --env-file=.env` — see package.json `dev`
#   the scripts     `node --env-file=.env …` — migrate, import, otp, email:status
#
# It used to be two — `.dev.vars` for the Worker, `.env` for the scripts — with
# the same secrets typed twice and drifting apart. Wrangler reads a plain .env
# since 4.x, so there is one now.
#
# NOT production. Nothing here is deployed. Production secrets are set once with
# `wrangler secret put NAME`; production variables live in wrangler.toml [vars].
# A value that exists only here is `undefined` in production. See docs/15.

# ───────────────────────────────────────────────────────────────────────────
# THE DATABASE
# ───────────────────────────────────────────────────────────────────────────

# Neon Postgres. THE database — content, events, accounts, audit, everything.
# There is NO local copy: this is the same database production uses, so a row
# edited while poking about is a row the Board sees. Branch in Neon if you want
# somewhere to break things — branching is instant, that is what they are for.
NEON_DB_URL=postgresql://user:password@ep-something.aws.neon.tech/neondb?sslmode=require

# ───────────────────────────────────────────────────────────────────────────
# ACCOUNTS
# ───────────────────────────────────────────────────────────────────────────

# Signs every session token. Any random string locally; rotating the production
# one signs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=local-dev-only-replace-me

# Who may reach /admin. Comma-separated, case-insensitive. THE authority on
# admin access — the database is not consulted, there is no role to grant and
# no password to hand anyone. Empty means nobody is an admin.
ADMIN_EMAILS=you@example.org

# ───────────────────────────────────────────────────────────────────────────
# OUTGOING MAIL — the confirmation code and the password reset
# ───────────────────────────────────────────────────────────────────────────

# Who carries the mail. Changing this is the whole switch; no code changes.
#
#   log         sends nothing, prints the email to the terminal. Start here —
#               sign-up works and the code is on screen with no credentials.
#   resend      one fetch. Needs RESEND_API_KEY and a domain verified at Resend.
#   cloudflare  the EMAIL binding in wrangler.toml. No API key, but the domain
#               must be onboarded: `wrangler email sending enable <domain>`.
EMAIL_PROVIDER=log

# The From address and the name beside it. The domain must be verified with
# whichever provider is set above; under `cloudflare` it must ALSO match
# allowed_sender_addresses in wrangler.toml.
#   npm run email:status     what is verified and what is still pending
EMAIL_FROM=noreply@example.org
EMAIL_NAME=Kurukshetra Saarthi

# Read ONLY when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# ───────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS — optional
# ───────────────────────────────────────────────────────────────────────────

# Without these /config reports no key and the app never offers notifications,
# which is a clean way to develop.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=

# The mailto: Web Push requires as the JWT subject. Push services may reject a
# token whose subject is not a real address.
VAPID_SUBJECT=mailto:you@example.org

# ───────────────────────────────────────────────────────────────────────────
# GOOGLE SIGN-IN — optional, dormant
# ───────────────────────────────────────────────────────────────────────────

# Until BOTH are set the button is not shown at all: an empty client id does
# not disable a provider, it produces a button that fails at Google. The OAuth
# client's authorised redirect URI must be <API_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────────────────────────────────────────────────────────────────────
# TOOLING — not read by the Worker
# ───────────────────────────────────────────────────────────────────────────

# Only for scripts run by hand. `wrangler` itself uses your own browser login,
# so this is optional.
CLOUDFLARE_API_TOKEN=
