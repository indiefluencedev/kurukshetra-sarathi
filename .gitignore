# dependencies
node_modules
/.pnp
.pnp.js

# build output
dist
dist-ssr
# vite-plugin-pwa's dev service worker. The comment is on its own line because
# .gitignore has no trailing comments — "dev-dist  # what it is" is a pattern
# matching a file with that whole string as its name, so the rule silently
# matched nothing and the generated worker was committed anyway.
dev-dist/
/build
/out

# vite / ts
.vite
*.tsbuildinfo

# testing
/coverage

# misc
.DS_Store
*.pem
*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env
.env*.local

# editor / os
.vercel

# claude code (local tooling)
.claude

# harvested review files, not shipped
apps/web/tools/out/

# wrangler's local D1 sandbox and build cache
.wrangler/

# wrangler local secrets — never committed
.dev.vars
apps/api/.dev.vars
.content.sql

# drizzle studio introspection output — regenerate with `npm run db:pull`
apps/api/drizzle/meta/

# production snapshot for Drizzle Studio — regenerate with `npm run db:snapshot`
apps/api/.prod.sqlite
apps/api/.prod-dump.sql
