{
  "name": "kurukshetra-saarthi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kuk/web",
    "build": "npm run build -w @kuk/web",
    "preview": "npm run preview -w @kuk/web",
    "check": "npm run check -w @kuk/web",
    "api:dev": "npm run dev -w @kuk/api",
    "api:deploy": "npm run deploy -w @kuk/api",
    "deploy": "npm run build && wrangler pages deploy apps/web/dist --project-name=kuk-saarthi --branch=main"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
