{
  "name": "kurukshetra-saarthi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check-content": "node scripts/check-content.mjs",
    "check-planner": "node --experimental-strip-types --import ./scripts/alias.mjs scripts/check-planner.mjs",
    "harvest-places": "node scripts/harvest-places.mjs",
    "build-graph": "node scripts/build-graph.mjs",
    "check-graph": "node --experimental-strip-types --import ./scripts/alias.mjs scripts/check-graph.mjs",
    "check-corridor": "node --experimental-strip-types --import ./scripts/alias.mjs scripts/check-corridor.mjs",
    "build-matrix": "node scripts/build-matrix.mjs",
    "check-matrix": "node --experimental-strip-types --import ./scripts/alias.mjs scripts/check-matrix.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
